#--------------------------------------------------------------------
# Define Alpine APK packaging function
#--------------------------------------------------------------------
# To install needed components:
# apk add alpine-sdk libcap-dev linux-headers
# addgroup $(USER) abuild
APKHOME	= $(HOME)/packages/$(APPNAME)

doapk	: vztar
	  @ echo "==> Production du paquet APK Alpine..."
	  @ rm -f $(APKHOME)/$$(uname -m)/$(APPNAME)*
	  @ mv $(APPNAME)-$(VERSION)*.tar.gz alpine/
	  @ cd alpine && abuild checksum && abuild -r
	  @ rm -fr alpine/$(APPNAME)-$(VERSION)*.tar.gz
	  @ echo ""
	  @ echo "================================================================="
	  @ echo "  APK package creation successful!"
	  @ echo "  Absolut path : $(APKHOME)/$$(uname -m)/"
	  @ echo ""
	  @ echo "  To install VZGOT (OpenRC) :"
	  @ echo "    doas apk add $(APKHOME)/$$(uname -m)/$(APPNAME)-$(VERSION)-r0.apk \\"
	  @ echo "                 $(APKHOME)/$$(uname -m)/$(APPNAME)-openrc-$(VERSION)-r0.apk"
	  @ echo ""
	  @ echo "  To install VZGOT (SysV init) :"
	  @ echo "    doas apk add $(APKHOME)/$$(uname -m)/$(APPNAME)-$(VERSION)-r0.apk \\"
	  @ echo "                 $(APKHOME)/$$(uname -m)/$(APPNAME)-sysv-$(VERSION)-r0.apk"
	  @ echo "================================================================="
