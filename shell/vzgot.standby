#!/bin/bash
#----------------------------------------------------
#shell used to download remote container and
#set it in standby mode
#
#----------------------------------------------------
#Syntax
#----------------------------------------------------
BINOME=$1
CONTAINER=$2		#Can be empty
ONBOOT=$3

#----------------------------------------------------
#adding vzgot tools
. `dirname $0`/vzgot.tools

#----------------------------------------------------

ETCVZGOT=/etc/vzgot
CONFDIR=${ETCVZGOT}

SNAP=`hostname -s`
. ${CONFDIR}/vzgot_config
if [ -z ${BINOME} ] ; then
  echo "Remote HOST NAME missing"
  exit 1
  fi
if [ -z ${CONTAINER} ] ; then
  CONTAINER=`ssh ${BINOME} vzgot online | cut -d ' ' -f1`
  fi
for tocheck in $(IFS=','; echo $CONTAINER)
  do
  CONT=`echo ${tocheck} | cut -d ':' -f1`
  LOCSTAT=`vzgot list | grep "^${CONT} " | grep "Up"`
  if [ -n "${LOCSTAT}" ] ; then
    echo -e "'${CONT}'\t already up and running on localhost=`hostname`"	
    continue
    fi
  NAME=`ssh ${BINOME} "vzgot list | grep '^${CONT} ' | tr -s ' ' | cut -d ' ' -f1"`
  if [ -z "${NAME}" ] ; then
    echo -e "'${CONT}'\t is not existing on remote system, exiting!"
    exit 1;
    fi
  REMPOOL=`ssh ${BINOME} "df -h | grep -E '/${CONT}$' | sed -E 's/[[:space:]]+/,/g' | cut -d',' -f2"`
  LOCPOOL=`df -h | grep -E "/${CONT}$" | sed -E 's/[[:space:]]+/,/g' | cut -d',' -f2`
  if [ -z "${LOCPOOL}" ] || [ "${LOCPOOL}" != "${REMPOOL}" ] ; then
    VZFS_SIZE=${REMPOOL};
    if [ "$(loc_create ${CONT})" = "0" ] ; then
      echo "Unable to create local '${CONT}' file system";
      continue
      fi
    fi
  #------------------------------------------------------------------
  #setting the local context
  REMFS=`ssh ${BINOME} "df -h 					|		\
		grep -E '/${CONT}$'				|		\
	      	sed -E 's/[[:space:]]+/,/g'			|		\
		cut -d',' -f6"`
  LOCFS=`df -h							|		\
	 	 grep -E "/${CONT}$"				|		\
		 sed -E 's/[[:space:]]+/,/g'			|		\
		 cut -d',' -f6`
  rsync -a ${BINOME}:${ETCVZGOT}/names/${CONT} ${CONFDIR}/names
  #------------------------------------------------------------------
  #data transfer
  rsync -a									\
	-e "ssh -x -T -c aes128-ctr -o Compression=no"				\
	--exclude "/dev/*"							\
	--exclude "/first.pid"							\
	--delete								\
	--numeric-ids								\
	${BINOME}:${REMFS}/*							\
	${LOCFS}
  if [ -z "${ONBOOT}" ] || [ "${ONBOOT}" != "yes" ] ; then
    ssh ${BINOME} "vzgot sleep ${CONT} 5" > /dev/null
    sleep 0.1
    else
    echo "Shutting down container '${CONT}' from '${BINOME}' remote Host"
    ssh ${BINOME} "vzgot shutdown ${CONT}" > /dev/null
    sleep 5
    fi
  rsync -a									\
	-e "ssh -x -T -c aes128-ctr -o Compression=no"				\
	--exclude "/dev/*"							\
	--exclude "/first.pid"							\
	--delete								\
	--numeric-ids								\
	${BINOME}:${REMFS}/*							\
	${LOCFS}
  . ${CONFDIR}/names/${CONT}
  if [ -z "${NOTE}" ] ; then
    echo "NOTE=\"Standby update\"" >> ${CONFDIR}/names/${CONT}
    fi
  sed -i 									\
	 -e "s:^HOMEFS=.*:HOMEFS=${LOCFS}:"					\
	 -e "s:^ONBOOT=.*:ONBOOT=\"standby\":"					\
	 -e "s/^NOTE=.*$/NOTE=\"Last update from ${BINOME} at `date -R`\"/g"	\
	 ${CONFDIR}/names/${CONT}
  . ${CONFDIR}/names/${CONT}
  #------------------------------------------------------------------
  #final report
  USED=`df -h ${HOMEFS} | grep ${HOMEFS} | tr -s ' ' | cut -d ' ' -f3`
  QUOTA=`df -h ${HOMEFS} | grep ${HOMEFS} | tr -s ' ' | cut -d ' ' -f2`
  printf "%10s %-20s Standby Ready %-10s %s\n"				\
	 	 `date +%T`						\
		 ${CONT}						\
		 ${QUOTA}/${USED}					\
		 ${HOMEFS}
  done
exit 0
