#!/usr/bin/env bash
#----------------------------------------------------
#shell used to prepare container rootfs according
#distribution type
#
#----------------------------------------------------
#Syntaxe
#vzgot.fistboot cont_name domain ip_list [Base]
#	cont_name is the container name
#	Domain is the container domainname 
#	IP_LIST is an ip list (ip,ip1,ip2,..) used
#		to prepare container network
#----------------------------------------------------
CONTNAME=$1
DOMAIN=$2
LSTIP=$3
#----------------------------------------------------
#extracting configuration
CONFDIR=/etc/vzgot
if ! [ -f ${CONFDIR}/vzgot_config ] ; then
  echo "Missing vzgot config file"
  exit 1	#trouble trouble
  fi

. ${CONFDIR}/vzgot_config

. ${CONFDIR}/names/${CONTNAME}

if [ -z "${HOMEFS}" ] ; then 
  echo "Missing ${CONTNAME} HOMEFS variable"
  exit 1	#trouble trouble
  fi

CONTDIR=${HOMEFS}
#specific container configuration override (if needed)
if [ -f ${CONTDIR}/vzgot_config ] ; then
  ${CONTDIR}/vzgot_config
  fi
#----------------------------------------------------
VZROOT=${CONTDIR}/rootfs
#====================================================
#procedure to implement Void distribution file
#----------------------------------------------------
#Preparing  container /etc/hosts file
#----------------------------------------------------

HOSTS="${VZROOT}/etc/hosts"
(
echo "#----------------------------------------------------"
echo "#done by vzgot.fboot"
echo "#----------------------------------------------------"
echo -e "127.0.0.1\tlocalhost.localdomain\tlocalhost"
) > $HOSTS

if [ -n $LSTIP ] ; then
  (
  echo -n `echo $LSTIP | tr ',' ' ' | cut -d' ' -f1`
  echo -e "\t${CONTNAME}.$DOMAIN\t\t${CONTNAME}"
  echo "#----------------------------------------------------"
  ) >> $HOSTS
  fi
#----------------------------------------------------
#set container hostname
HOSTNAME="${VZROOT}/etc/hostname"
(
echo "${CONTNAME}.$DOMAIN"
) > $HOSTNAME

RCLOCAL="${VZROOT}/etc/rc.local"
# Start with a clean shebang if the file doesn't exist
if [ ! -f "${RCLOCAL}" ]; then
    echo "#!/bin/sh" > "${RCLOCAL}"
fi

if [ -n $LSTIP ] ; then
  ETH0=`echo $LSTIP | tr ',' ' ' | cut -d' ' -f1`
  (
  echo ""
  echo "#----------------------------------------------------"
  echo "# vzgot Network Initialization"
  echo "#----------------------------------------------------"
  echo "ip link set dev eth0 up"
  echo "ip addr add $ETH0/32 dev eth0"

  # Define IPV6 if prefix is provided
  if [ -n "$NETIP6" ]; then
    echo "ip -6 addr add $NETIP6::$ETH0/128 dev eth0"
  fi
  # Parse and configure alias IPs (secondary addresses)
  ETHX=`echo $LSTIP | tr ',' ' ' | cut -s -d' ' -f2-`
  aliasnum=1
  for eth in $ETHX 
    do
    # Under modern Linux, we use 'label' to show aliases
    # in legacy tools like ifconfig
    echo "ip addr add $eth/32 dev eth0 label eth0:$aliasnum"
    aliasnum=$((aliasnum + 1))
    done
  # Define default IPV4 route parameters
    echo "ip route add 192.0.2.0/24 dev eth0 scope link"
    echo "ip route add default via 192.0.2.1 dev eth0"

  # Define default IPV6 route parameters
    if [ -n "$NETIP6" ]; then
      echo "ip -6 route add fc00::192.0.2.1/128 dev eth0 scope link"
      echo "ip -6 route add default via fc00::192.0.2.1 dev eth0"
    fi
    echo "#----------------------------------------------------"
  ) >> ${RCLOCAL}
  # Make sure rc.local is executable so runit runs it at boot
  chmod +x "$RCLOCAL"
  fi


#----------------------------------------------------
#Prepare /dev directoy contents
DEV="${VZROOT}/dev"
#NOTHING specific to be added to container /dev

#----------------------------------------------------
FSTAB="${VZROOT}/etc/fstab"
(
echo -e "/$CONTNAME\t\t/\t\t\text4\tdefaults\t\t0 0"
echo -e "proc\t\t/proc\t\t\tproc\tdefaults\t\t0 0"
echo -e "sysfs\t\t/sys\t\t\tsysfs\tdefaults\t\t0 0"
echo -e "devpts\t\t/dev/pts\t\tdevpts\trw,noexec,nosuid,mode=0620\t0 0"
echo -e "tmpfs\t\t/run\t\ttmpfs\tdefaults\t\t0 0"
) > $FSTAB

#to get mounted partition data
ln -snf /proc/mounts ${VZROOT}/etc/mtab

#setting the DNS resolver
if [ -f /etc/resolv.conf ] ; then
  cp -a /etc/resolv.conf ${VZROOT}/etc
  fi

#inserting hostname 
echo ${CONTNAME}.$DOMAIN > ${VZROOT}/etc/hostname

#adding /run directory
mkdir -p ${VZROOT}/run

#====================================================
# Disable physical TTYs (agetty) under Void/Runit
# to prevent infinite respawn loops in the container
#----------------------------------------------------
rm -f ${VZROOT}/etc/runit/runsvdir/default/agetty-tty*
rm -f ${VZROOT}/var/service/agetty-tty*
#stopping console
rm -f ${VZROOT}/var/service/agetty-console
rm -f ${VZROOT}/etc/runit/runsvdir/default/agetty-console
#stopping dhclient
rm -f ${VZROOT}/var/service/dhclient*
rm -f ${VZROOT}/etc/runit/runsvdir/default/dhclient*
#stopping udevd
#rm -rf ${VZROOT}/var/service/udevd
#rm -rf ${VZROOT}/etc/runit/runsvdir/default/udevd
#stopping nanoklogd
rm -rf ${VZROOT}/var/service/nanoklogd
rm -rf ${VZROOT}/etc/runit/runsvdir/default/nanoklogd

#remove sysctl services
for service in 01-static-devs.sh 02-udev.sh 06-sysctl.sh 08-sysctl.sh; do
  if [ -f "${VZROOT}/etc/runit/core-services/$service" ]; then
    echo "#!/bin/sh"						\
	   	> "${VZROOT}/etc/runit/core-services/$service"
    echo "#no sysctl needed as a vzgot container" 		\
    		>> "${VZROOT}/etc/runit/core-services/$service"
    fi
done

#set ssh actif
ln -nsf /etc/sv/sshd ${VZROOT}/etc/runit/runsvdir/default/sshd
#====================================================

#lets create common users and groups
ARCH=`cat $VZDIR/$CONTNAME/arch`
CHROOT="/usr/bin/setarch $ARCH chroot"

$CHROOT ${VZROOT} mount -t proc proc /proc
$CHROOT ${VZROOT} mount -t sysfs sysfs /sys

#removing udev family auto start
UDEV="/sbin/start_udev"
if [ ! -f $UDEV.org ] ; then
  $CHROOT ${VZROOT} /bin/mv $UDEV $UDEV.org > /dev/null 2>&1
  $CHROOT ${VZROOT} /bin/ln /bin/true $UDEV > /dev/null 2>&1
  fi

$CHROOT ${VZROOT} umount /sys
$CHROOT ${VZROOT} umount /proc
#====================================================
#case of systemd
TGTSYSD=${VZROOT}/etc/systemd/system/getty.target.wants
if [ -d $TGTSYSD ] ; then
  rm -fr $TGTSYSD
  ln -s /dev/null $TGTSYSD
  fi


#====================================================
#limiting access to root account
sed -i -e "s/:\!\*:/:\*:/" ${VZROOT}/etc/shadow
sed -i -e "s:/bin/sh:/usr/bin/bash:" ${VZROOT}/etc/passwd
   
#====================================================
#adding default iptables
cp -a ${VZ_DATA_LIB}/etc/sysconfig/iptables	\
      ${VZROOT}/etc/iptables/iptables.rules

#====================================================
#updating template with adapted startup file
cp -a						\
  ${CONFDIR}/distributions/void/core-services/*\
  ${VZROOT}/etc/runit/core-services/

#====================================================
exit 0
