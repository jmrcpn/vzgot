#! /usr/bin/bash
#----------------------------------------------------
#shell used to prepare container rootfs according
#distribution type
#
#----------------------------------------------------
#Syntaxe
#vzgot.fistboot cont_name domain ip_list [Base]
#	cont_name is the container name
#	Domain is the container domainname 
#	IP_LIST is an ip list (ip,ip1,ip2,..) used
#		to prepare container network
#----------------------------------------------------
CONTNAME=$1
DOMAIN=$2
LSTIP=$3
#----------------------------------------------------
#extracting configuration
CONFDIR=/etc/vzgot
if ! [ -f ${CONFDIR}/vzgot_config ] ; then
  echo "Missing vzgot config file"
  exit 1	#trouble trouble
  fi

. ${CONFDIR}/vzgot_config

. ${CONFDIR}/names/${CONTNAME}

if [ -z "${HOMEFS}" ] ; then 
  echo "Missing ${CONTNAME} HOMEFS variable"
  exit 1	#trouble trouble
  fi

CONTDIR=${HOMEFS}
#specific container configuration override (if needed)
if [ -f ${CONTDIR}/vzgot_config ] ; then
  ${CONTDIR}/vzgot_config
  fi
#----------------------------------------------------
VZROOT=${CONTDIR}/rootfs
#====================================================
#procedure to implement Ubuntu distribution file
#----------------------------------------------------
#Prepare /etc/hosts file
HOSTS="/${VZDIR}/${CONTNAME}/rootfs/etc/hosts"
(
echo "#----------------------------------------------------"
echo "#done by vzgot.fboot"
echo "#----------------------------------------------------"
echo -e "127.0.0.1\tlocalhost.localdomain\tlocalhost"
) > ${HOSTS}

if [ -n "${LSTIP}" ] ; then
  (
  IPV4=`echo ${LSTIP} | tr ',' ' ' | cut -d' ' -f1`
  echo -e "${IPV4}\t\t\t${CONTNAME}.${DOMAIN}\t\t${CONTNAME}"
  echo -e "${NETIP6}::${IPV4}\t${CONTNAME}.${DOMAIN}\t\t${CONTNAME}"
  echo "#----------------------------------------------------"
  ) >> ${HOSTS}
  fi

#----------------------------------------------------
#set container hostname
HOSTNAME="${VZROOT}/etc/hostname"
(
echo "${CONTNAME}.${DOMAIN}"
) > ${HOSTNAME}

#setting the DNS resolver using the Host resolv.conf
if [ -f /etc/resolv.conf ] ; then
  rm -f ${VZROOT}/etc/resolv.conf
  cp -a /etc/resolv.conf ${VZROOT}/etc/resolv.conf
  fi

#----------------------------------------------------
#set network in manual mode
NDIR=${VZROOT}/etc/netplan/
mv ${NDIR}/10-lxc.yaml ${NDIR}/10-lxc.yaml.orig

INTER=${NDIR}/10-lxc.yaml
if [ -n ${LSTIP} ] ; then
  ETH0=`echo ${LSTIP} | tr ',' ' ' | cut -d' ' -f1`
  (
  echo "#----------------------------------------------------"
  echo "# vzgot Network Initialization"
  echo "#----------------------------------------------------"
  echo "network:"
  echo "  version: 2"
  echo "  ethernets:"
  echo "    eth0:"
  echo "      dhcp4: false"
  echo "      addresses:"
  echo "        - $ETH0/32"
  echo "      routes:"
  echo "        - to: 192.0.2.0/24"
  echo "          scope: link"
  echo "        - to: default"
  echo "          via: 192.0.2.1"
  echo "#----------------------------------------------------"
  ) >> ${INTER}
  chmod 600 ${INTER}
  fi


#----------------------------------------------------
#Prepare directoy /etc/fstab
FSTAB="${VZROOT}/etc/fstab"
(
echo -e "/$CONTNAME\t\t/\t\t\text4\tdefaults\t\t0 0"
echo -e "proc\t\t/proc\t\t\tproc\tdefaults\t\t0 0"
echo -e "sysfs\t\t/sys\t\t\tsysfs\tdefaults\t\t0 0"
echo -e "tmpfs\t\t/dev\t\t\ttmpfs\tsize=10k\t\t0 0"
echo -e "devpts\t\t/dev/pts\t\tdevpts\trw,noexec,nosuid,mode=0620\t0 0"
echo -e "tmpfs\t\t/run\t\ttmpfs\tdefaults\t\t0 0"
) > $FSTAB

#to get mounted partition data
ln -snf /proc/mounts ${VZROOT}/etc/mtab

#====================================================
#limiting access to root account
sed -i 's/^root:[^:]*/root:*/' ${VZROOT}/etc/shadow
sed -i -e "s:/bin/sh:/usr/bin/bash:" ${VZROOT}/etc/passwd
   
#====================================================
#avoiding firstboot
chroot "${VZROOT}" systemd-id128 new > "${VZROOT}/etc/machine-id"

#Default working mode is multi-user
ln -sf	/usr/lib/systemd/system/multi-user.target	\
	${VZROOT}/etc/systemd/system/default.target

#removing kernel-debug-mount service
ln -sf /dev/null "${VZROOT}/etc/systemd/system/sys-kernel-debug.mount"
ln -sf /dev/null "${VZROOT}/etc/systemd/system/sys-kernel-tracing.mount"
ln -sf /dev/null "${VZROOT}/etc/systemd/system/systemd-remount-fs.service"

#removing automount
#ln -sf /dev/null "${VZROOT}/etc/systemd/system/proc-sys-fs-binfmt_misc.automount"
#ln -sf /dev/null "${VZROOT}/etc/systemd/system/proc-sys-fs-binfmt_misc.mount"
#ln -sf /dev/null "${VZROOT}/etc/systemd/system/sys-kernel-tracing.mount"
#ln -sf /dev/null "${VZROOT}/etc/systemd/system/systemd-remount-fs.service"

#Stop first boot
#ln -sf /dev/null "${VZROOT}/etc/systemd/system/systemd-firstboot.service"

#====================================================
#adding default iptables
mkdir -p ${VZROOT}/etc/iptables
cp -a ${VZ_DATA_LIB}/etc/sysconfig/iptables	\
      ${VZROOT}/etc/iptables/rules.v4

#====================================================
exit 0
