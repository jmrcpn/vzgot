#!/usr/bin/env bash
#----------------------------------------------------
#shell used to display the list of container
#
#----------------------------------------------------
affiche()

{
#$1=CallID
#$2=NAME
#$3=Boot status
#$4=UP/DOWN
#$5=IP
#$6=HOMEFS
#$7=NOTE

NAME=$1			#container name
BOOTSTAT=$2		#container boot status
UPSTAT=$3		#container up or down
IPADDR=$4		#container IP address
HOMEFS=$5		#container home directory
NOTE=$6

taille=${#CALLID}
tab1=`echo 25 - $taille | bc`
  
printf "%s  %*s%9s  %30s  %-30s\n" "$NAME" $tab1 "$BOOTSTAT" "$UPSTAT" "$IPADDR" "$HOMEFS" 
if [ -n "${NOTE}" ] ; then
  printf "%-24s%s\n" "" "$NOTE"
  fi
}

#----------------------------------------------------
CONFDIR=/etc/vzgot
affiche	"Name" "Boot_mode"  "running" "IP num" "home directory"
for cont in `ls $CONFDIR/names`
  do
  CALLID=${cont}
  NAME=""
  ONBOOT=""
  HOMEFS=""
  NOTE=""
  . $CONFDIR/names/$cont
  IPADDR=`getent hosts ${FULLNAME} | cut -d ' ' -f1`
  UPSTAT="Down"
  if [ -f $HOMEFS/first.pid ] ; then
    CONTPID=`cat ${HOMEFS}/first.pid`
    if [ -n "${CONTPID}" -a -e /proc/${CONTPID} ] ; then
      UPSTAT="Up"
      fi
    fi
  affiche ${NAME} ${ONBOOT} ${UPSTAT} ${IPADDR} ${HOMEFS} "${NOTE}"
  done
exit 0
