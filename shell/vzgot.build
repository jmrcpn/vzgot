#!/usr/bin/bash
#----------------------------------------------------
#shell used to build the root file system for the
#container, incoming file is a tar file to
#insert within the vzgot directory structure
#
#----------------------------------------------------
#Syntaxe
#vzgot.build name tpl_tar_filename dist arch base_dir
#	VE_name is the container dir name
#	tpl_tar_filename is the template file name to be used
#	dist is the distribution name (Alpine,debian, etc..)
#	arch is the architecture base (i386, x86_64)
#----------------------------------------------------
CONTNAME=$1
TARFILE=$2
DIST=$3
ARCH=$4


#adding vzgot tools
. `dirname $0`/vzgot.tools

#----------------------------------------------------
if [ -d ${VZDIR}/${CONTNAME} ] ; then
  echo "Container ${CONTNAME} already existing, must be destroyed first"
  abort "Use command \"vzgot destroy ${CONTNAME}\" to do it"
  fi

#----------------------------------------------------
#creating Container directory
if [ -z "${VZFS_SIZE}" ] ; then
  VZFS_SIZE="2G"
  fi
loc_create "${CONTNAME}"

CONTDIR=${VZDIR}/${CONTNAME}
VZROOT=${CONTDIR}/rootfs

mkdir -p ${VZROOT}
#installing template
tar -C ${VZROOT} -xf /var/lib/vzgot/vztemplates/${TARFILE}
ret=$?
if [ $ret -ne 0 ]; then
  abort "vzgot.build, Unable to install template file $TPL!"
  fi
#----------------------------------------------------
#setting the container architecture 
echo $ARCH > ${CONTDIR}/arch
#setting the container distribution 
echo $DIST > ${CONTDIR}/dist

touch ${CONTDIR}/console
chmod 644 ${CONTDIR}/console
#----------------------------------------------------
#populating devref probing devices data from HOST
DEVREF=${CONTDIR}/devref
mkdir -p ${DEVREF}
(
cd /dev
rsync -a 		\
	console		\
	full		\
	fuse		\
	loop-control	\
	mem		\
	null		\
	ptmx		\
	random		\
	stderr		\
	stdin		\
	stdout		\
	tty		\
	urandom		\
	zero		\
	${DEVREF}
)

#To preset some loop device within container
for i in $(seq 0 7);
  do
  if [ ! -e "${DEVREF}/loop${i}" ]; then
    mknod -m 660 "${DEVREF}/loop${i}" b 7 ${i}
  fi
  done

mkdir -m 755 ${DEVREF}/pts

#----------------------------------------------------
#final exit
exit 0
