#Maintainer: Jean-Marc Pigeon <jmp@safe.ca>
pkgname=vzgot
pkgver=26.09.67
pkgrel=1
pkgdesc="Lightweight C-based container manager supervisor"
url="https://github.com/jmrcpn/vzgot"
arch="all"
license="GPL-3.0-or-later"
makedepends="linux-headers libcap-dev"
depends="musl mount libc-utils bash net-tools bind-tools coreutils xz rsync iproute2"
options="!check"

# Sub packages
subpackages="$pkgname-openrc:openrc:noarch"
subpackages="$subpackages $pkgname-sysv:sysv:noarch"
subpackages="$subpackages $pkgname-systemd:systemd:noarch"

install="
	$pkgname-openrc.post-install
	$pkgname-openrc.post-upgrade
	$pkgname-openrc.post-deinstall
	"

source="$pkgname-$pkgver.tar.gz"
#builddir="$srcdir/$pkgname-$pkgver"

build() {
	make prod
	}

package() {
	make DESTDIR="$pkgdir" install
	# Installation du script OpenRC
	}

# Sous-paquet SysV / Init
sysv() {
	pkgdesc="SysV init script for vzgot"
	depends="$pkgname=$pkgver-r$pkgrel"
	subpkgarch="noarch"

	mkdir -p "$subpkgdir"/etc/init.d
	mv "$pkgdir"/etc/rc.d/init.d/vzgot "$subpkgdir"/etc/init.d/vzgot
	}

openrc() {
	pkgdesc="OpenRC init script for vzgot"
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	subpkgarch="noarch"

	mkdir -p "$subpkgdir"/etc/init.d
	mv "$pkgdir"/etc/init.d/vzgotrc "$subpkgdir"/etc/init.d/vzgot
	}

# Sous-paquet systemd
systemd() {
	pkgdesc="systemd service unit for vzgot"
	depends="$pkgname=$pkgver-r$pkgrel"
	subpkgarch="noarch"

	# Déplace le répertoire systemd dans le sous-paquet vzgot-systemd
	amove usr/lib/systemd
	}

